# Bot token from the Discord Developer Portal
DISCORD_TOKEN=
# Channel to post into (right-click the channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Optional: role to ping (right-click the role -> Copy Role ID)
PING_ROLE_ID=
# Posts that ping the role: update, changelist, depots, news, banner, avatar, all or none
#PING_EVENTS=update,news

# Optional settings (defaults shown)
#PICS_INTERVAL_MS=2000
#NEWS_INTERVAL_SECS=20
#TWITTER_INTERVAL_SECS=60
#TWITTER_HANDLE=CounterStrike
#STATUS_INTERVAL_SECS=60
# Platform icon next to the online status: vr, mobile or desktop
#PRESENCE_PLATFORM=vr
#AUTO_UPDATE=true
#UPDATE_INTERVAL_MINS=10
#STATE_FILE=state.json

# Optional TeamSpeak bot (TS3/TS6) that plays a sound on game updates
#TS_ADDRESS=ts.example.com
# Channel name, or Parent/Child if the name is not unique; empty = default channel
#TS_CHANNEL=CS2
#TS_CHANNEL_PASSWORD=
#TS_SERVER_PASSWORD=
#TS_NICKNAME=CS2 Tracker
#TS_EVENTS=update
# Own sound as Ogg Opus file; empty = bundled chime
#TS_SOUND_FILE=
#RUST_LOG=info,steam_vent=warn,twilight_gateway=warn,tsclientlib=error,tsproto=error,ts_bookkeeping=error
