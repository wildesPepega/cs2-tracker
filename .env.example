# Bot token from the Discord Developer Portal
DISCORD_TOKEN=
# Channel to post into (right-click the channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Optional: role to ping (right-click the role -> Copy Role ID)
PING_ROLE_ID=
# Posts that ping the role: update, changelist, depots, news, banner, all or none
#PING_EVENTS=update,news

# Optional settings (defaults shown)
#PICS_INTERVAL_MS=2000
#NEWS_INTERVAL_SECS=20
#TWITTER_INTERVAL_SECS=60
#TWITTER_HANDLE=CounterStrike
#STATUS_INTERVAL_SECS=60
# Platform icon next to the online status: vr, mobile or desktop
#PRESENCE_PLATFORM=vr
#AUTO_UPDATE=true
#UPDATE_INTERVAL_MINS=10
#STATE_FILE=state.json
#RUST_LOG=info,steam_vent=warn,twilight_gateway=warn
